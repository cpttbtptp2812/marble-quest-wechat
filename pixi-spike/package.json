{
  "name": "marble-quest-pixi-spike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PixiJS 8 + Sapling2D rendering and physics migration spike for Marble Quest",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:wechat": "vite build -c vite.wechat.config.ts",
    "dev:wechat": "vite build -c vite.wechat.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm run build:wechat"
  },
  "dependencies": {
    "pixi.js": "~8.22.0",
    "planck": "^1.5.0",
    "sapling2d": "0.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
